{
  "datasets": [
    {
      "name": "0ee48276",
      "displayName": "Earthquake_details",
      "queryLines": [
        "select * from youtube_dev.silver.earthquake_data_final"
      ],
      "catalog": "youtube_dev",
      "schema": "silver"
    },
    {
      "name": "7489c330",
      "displayName": "Magnitude_range_of_EQ",
      "queryLines": [
        "select count(*) as total_magnitude_range, \r\n",
        "magnitude_range from\r\n",
        "(select \r\n",
        "    CASE when mag < 2 then \"Micro(<2)\"\r\n",
        "        when mag between 2 and 3 then \"Minor(2-3)\"\r\n",
        "        when mag between 3 and 4 then \"Light(3-4)\"\r\n",
        "    else 'Parameter (+4)'\r\n",
        "end as magnitude_range\r\n",
        "from youtube_dev.silver.earthquake_data_final)\r\n",
        "group by magnitude_range"
      ]
    },
    {
      "name": "5feb4af9",
      "displayName": "Country from Earthquake Location",
      "queryLines": [
        "select\r\n",
        "  count(*) as event_count,\r\n",
        "  case\r\n",
        "    when size(split(place, ', ')) = 1 then split(place, ', ')[0]\r\n",
        "    else split(place, ', ')[1]\r\n",
        "  end as country\r\n",
        "from\r\n",
        "(\r\n",
        "    select\r\n",
        "      * from  youtube_dev.silver.earthquake_data_final\r\n",
        ") group by country\r\n"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    }
  ],
